# Copy to .env (git-ignored) and fill in real values locally.
# Never commit the real .env file.

# Proxmox API (Terraform bpg/proxmox provider)
PROXMOX_VE_ENDPOINT=https://<PROXMOX_IP>:8006/
PROXMOX_VE_API_TOKEN=<USER>@pve!<TOKEN_ID>=<TOKEN_SECRET>
PROXMOX_VE_INSECURE=true

# Kubernetes
KUBECONFIG=~/.kube/homelab.yaml

# Backups (restic to Backblaze B2)
B2_ACCOUNT_ID=<B2_KEY_ID>
B2_ACCOUNT_KEY=<B2_APPLICATION_KEY>
RESTIC_REPOSITORY=b2:<BUCKET_NAME>:<PATH>
RESTIC_PASSWORD=<RESTIC_PASSWORD>

# UniFi API (device inventory check)
UNIFI_HOST=https://<GATEWAY_IP>
UNIFI_API_KEY=<UNIFI_API_KEY>

# Notifications
NTFY_TOPIC_URL=https://ntfy.sh/<PRIVATE_TOPIC>

# AI services
ANTHROPIC_API_KEY=<ANTHROPIC_API_KEY>
OLLAMA_HOST=http://<OLLAMA_SERVICE>:11434
